{
  "name": "possum-bot-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/safe-next-build.js --auto",
    "build:vm": "node scripts/safe-next-build.js --vm",
    "build:raw": "node --max-old-space-size=512 ./node_modules/next/dist/bin/next build --webpack",
    "build:turbo": "node ./node_modules/next/dist/bin/next build --turbopack",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "deploy:vm": "node scripts/deploy-vm.js",
    "catalog:sync": "node scripts/sync-catalog.js",
    "prebuild": "node scripts/sync-catalog.js",
    "predev": "node scripts/sync-catalog.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "better-sqlite3": "^12.6.2",
    "ioredis": "^5.10.0",
    "next": "^16.1.6",
    "prisma": "^7.4.2",
    "rate-limiter-flexible": "^9.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.34",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.9.3"
  }
}
