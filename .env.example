NODE_ENV=production
PORT=3000

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://dashboard.example.com/api/auth/discord/callback
SESSION_SECRET=

DASHBOARD_PUBLIC_URL=https://dashboard.example.com
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.example.com
DASHBOARD_URL=https://dashboard.example.com

BOT_API_URL=http://127.0.0.1:3001
DASHBOARD_API_TOKEN=
BOT_API_TIMEOUT_MS=45000
POSSUM_BOT_ROOT=/absolute/path/to/bot/repository

# Optional integrations/settings
REDIS_URL=
CONTROL_GUILD_IDS=
NEXT_PUBLIC_SUPPORT_SERVER_INVITE_URL=

# --- Operations monitor (possum-ops-agent) ---
# Required. The agent refuses to boot without it. Same value in the dashboard env.
OPS_AGENT_TOKEN=
OPS_AGENT_HOST=127.0.0.1
OPS_AGENT_PORT=3190
# Private ops-channel webhook. Unset = alerts queue locally and are never sent.
OPS_DISCORD_WEBHOOK_URL=
OPS_CHECK_INTERVAL_MS=15000
OPS_METRICS_INTERVAL_MS=15000
OPS_LOG_POLL_INTERVAL_MS=2000
OPS_ALERT_REPEAT_MS=900000
OPS_RETENTION_DAYS=180
OPS_BOT_HEALTH_URL=http://127.0.0.1:3001/api/health
OPS_DASHBOARD_HEALTH_URL=http://127.0.0.1:3000/api/healthz
OPS_BRIDGE_HEALTH_URL=http://127.0.0.1:3210/health
PM2_LOG_DIR=
